<launch>
  <arg name="uav_id" default="1"/>
  <arg name="tracking_distance" default="10.0"/>
  <arg name="kp_x" default="0.25"/>
  <arg name="kp_z" default="0.10"/>
  <arg name="kp_gimbal" default="1.0"/>
  <arg name="max_velocity" default="1.0"/>
  <arg name="max_yaw_rate" default="30.0"/>
  <arg name="dry_run" default="true"/>
  <node pkg="p450_yolo_compare_tracking" type="gimbal_target_controller" name="gimbal_target_controller" output="screen">
    <param name="uav_id" value="$(arg uav_id)"/>
    <param name="tracking_distance" value="$(arg tracking_distance)"/>
    <param name="kp_x" value="$(arg kp_x)"/>
    <param name="kp_z" value="$(arg kp_z)"/>
    <param name="kp_gimbal" value="$(arg kp_gimbal)"/>
    <param name="max_velocity" value="$(arg max_velocity)"/>
    <param name="max_yaw_rate" value="$(arg max_yaw_rate)"/>
    <param name="dry_run" value="$(arg dry_run)"/>
  </node>
</launch>
