Panels:
- Class: rviz/Displays
  Name: Displays
Visualization Manager:
  Class: ''
  Global Options:
    Fixed Frame: map
    Frame Rate: 15
    Background Color: 30; 30; 30
  Displays:
  - Class: rviz/Grid
    Name: Ground
    Enabled: true
    Cell Size: 1
    Plane Cell Count: 48
  - Class: rviz/PointCloud2
    Name: DUFOMap static - measured points
    Enabled: true
    Topic: /dufomap/static_map
    Queue Size: 1
    Position Transformer: XYZ
    Color Transformer: FlatColor
    Color: 70; 220; 170
    Style: Points
    Size (Pixels): 2
    Alpha: 1
  - Class: rviz/PointCloud2
    Name: DUFOMap classified dynamic - excluded from static map
    Enabled: false
    Topic: /dufomap/removed_points
    Queue Size: 1
    Position Transformer: XYZ
    Color Transformer: FlatColor
    Color: 255; 145; 40
    Style: Points
    Size (Pixels): 3
    Alpha: 0.8
  - Class: rviz/PointCloud2
    Name: Ours local maintained map - toggle for comparison
    Enabled: false
    Topic: /uav1/fastlio/cloud_map
    Queue Size: 1
    Position Transformer: XYZ
    Color Transformer: AxisColor
    Axis: Z
    Style: Points
    Size (Pixels): 2
    Alpha: 0.8
  - Class: rviz/Path
    Name: Actual navigation route
    Enabled: true
    Topic: /uav1/planner/local_path
    Color: 255; 70; 190
    Line Style: Billboards
    Line Width: 0.05
  - Class: rviz/MarkerArray
    Name: Frontier viewpoints and state
    Enabled: true
    Marker Topic: /uav1/exploration/markers
  - Class: rviz/MarkerArray
    Name: Dynamic people
    Enabled: true
    Marker Topic: /uav1/dynamic_markers
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 36
      Pitch: 1.0
      Yaw: 2.3
      Focal Point:
        X: 0
        Y: 0
        Z: 0
  Tools:
  - Class: rviz/Interact
  - Class: rviz/MoveCamera
  - Class: rviz/Select
  - Class: rviz/FocusCamera
  - Class: rviz/Measure
Window Geometry:
  Width: 1250
  Height: 900
