<launch>
  <arg name="rviz" default="true"/>
  <arg name="output"/>
  <arg name="return_after_goals" default="0"/>
  <arg name="enable_ghost_revisit" default="true"/>
  <arg name="enable_loop_closure" default="false"/>
  <arg name="online_loop" default="false"/>
  <arg name="vertical_view_audit" default="false"/>
  <arg name="mission_policy" default="legacy"/>
  <arg name="quality_target" default="0.85"/>
  <arg name="surface_inspection" default="false"/>
  <arg name="max_mission_wall_seconds" default="1100.0"/>
  <arg name="unlimited_flight" default="false"/>
  <include file="$(find fastlio_bridge)/launch/half_warehouse_exploration.launch">
    <arg name="rviz" value="$(arg rviz)"/>
    <arg name="output" value="$(arg output)"/>
    <arg name="return_after_goals" value="$(arg return_after_goals)"/>
    <arg name="enable_ghost_revisit" value="$(arg enable_ghost_revisit)"/>
    <arg name="enable_loop_closure" value="$(arg enable_loop_closure)"/>
    <arg name="online_loop" value="$(arg online_loop)"/>
    <arg name="vertical_view_audit" value="$(arg vertical_view_audit)"/>
  </include>
  <rosparam command="load" file="$(find fastlio_bridge)/config/half_warehouse_ten_minute.yaml"/>
  <rosparam if="$(eval arg('mission_policy') != 'legacy')" command="load"
    file="$(find fastlio_bridge)/config/half_warehouse_joint_channel.yaml"/>
  <param if="$(eval arg('mission_policy') != 'legacy')" name="/warehouse_explorer/joint_strategy"
    value="$(eval 'simple' if arg('mission_policy') == 'joint-simple' else 'channel_verification')"/>
  <param name="/warehouse_explorer/surface_quality_target" value="$(arg quality_target)"/>
  <rosparam if="$(arg surface_inspection)" command="load"
    file="$(find fastlio_bridge)/config/half_warehouse_surface_inspection.yaml"/>
  <param name="/warehouse_explorer/max_mission_wall_seconds" value="$(arg max_mission_wall_seconds)"/>
  <param if="$(arg unlimited_flight)" name="/warehouse_explorer/flight_budget_seconds" value="0"/>
  <param if="$(arg unlimited_flight)" name="/warehouse_explorer/flight_budget_unlimited" value="true"/>
</launch>
